# SDU History Learning Platform - Environment Configuration

# SDU University Auth / Backend API URL
VITE_API_BASE_URL=https://api.sdu.edu.kz/v1

# Use mock authentication for development & testing (set to false for production LDAP/OAuth)
VITE_USE_MOCK_AUTH=true

# Application Name
VITE_APP_TITLE=SDU QazHistory

# Default Language (kk or en)
VITE_DEFAULT_LANGUAGE=kk
