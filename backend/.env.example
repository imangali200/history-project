# Environment configuration for QAZHISTORY Backend
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection (Default local or Docker container)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qazhistory_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="qazhistory_steppe_access_secret_super_secure_key_2026"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="qazhistory_steppe_refresh_secret_ultra_secure_key_2026"
JWT_REFRESH_EXPIRES_IN="30d"

# SDU University Integration (Mock or SDU LDAP/SSO Portal API)
SDU_PORTAL_API_URL="https://my.sdu.edu.kz/api"
SDU_MOCK_ENABLED=true

# AI Historical Tutor (AI Tarihshy)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Redis Cache (Optional for dev, required for production leaderboards)
REDIS_HOST=localhost
REDIS_PORT=6379
